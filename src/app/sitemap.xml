import { MetadataRoute } from 'next'

export default async function sitemap(): Promise<MetadataRoute.Sitemap> {
  const baseUrl = 'https://usanewsflow.com'

  // ডায়নামিক ক্যাটাগরি বা ব্লগ পোস্টের URL এখানে ফেচ করে বসাতে পারেন
  return [
    { url: baseUrl, lastModified: new Date() },
    { url: `${baseUrl}/about-us`, lastModified: new Date() },
    { url: `${baseUrl}/editorial-policy`, lastModified: new Date() },
    { url: `${baseUrl}/terms-of-use`, lastModified: new Date() },
  ]
}